# Copy to .env and fill in. Never commit .env.
# Servers will be added in the setup screen later; these are for development only.
HORUS_PLEX_URL=http://localhost:32400
HORUS_PLEX_TOKEN=
HORUS_EMBY_URL=http://localhost:8096
HORUS_EMBY_API_KEY=
HORUS_DB_PATH=./data/horus.db
HORUS_POLL_SECONDS=15

# Optional: a control key for a TEST copy of Horus, used by scripts/horusctl.py
# (make one under Settings > API > Control keys). Never commit real values.
HORUS_TEST_URL=
HORUS_TEST_CONTROL_KEY=
